+      $('windChipText').textContent = 'Wind ' + label;
+      $('windChip').style.display = windEnabled ? 'block' : 'none';
+      if ($('quickWindStatus')) $('quickWindStatus').innerHTML = '<strong>Modeled wind:</strong> ' + escapeHtml(label) + '<br>Animated 10 m wind field • Open-Meteo data.';
+    } catch (e) {
+      windGrid = null;
+      if ($('quickWindStatus')) $('quickWindStatus').textContent = 'Wind layer unavailable: ' + (e.message || e);
+      $('windChipText').textContent = 'Wind unavailable';
+    } finally {
+      windLoading = false;
+    }
+  }
