index d1093d1..58b8094 100644
--- a/app/src/main/assets/index.html
+++ b/app/src/main/assets/index.html
@@ -306,6 +306,40 @@ html, body {
   .sheet { border-radius: 28px 28px 20px 20px; margin-bottom:18px; }
 }
 
+/* v0.6 quick layers + animated wind */
+#layersQuickBtn { left: 12px; top: 12px; min-height: 38px; padding: 8px 12px; display:flex; align-items:center; gap:7px; }
+#layersQuickBtn svg { width:17px; height:17px; fill:none; stroke:currentColor; stroke-width:2; stroke-linecap:round; stroke-linejoin:round; }
+#layersQuickPanel {
+  position:absolute; left:12px; top:58px; z-index:960; width:min(310px,calc(100% - 24px)); display:none;
+  background:rgba(252,254,255,.96); border:1px solid rgba(255,255,255,.8); border-radius:22px;
+  box-shadow:0 16px 42px rgba(4,35,52,.24); backdrop-filter:blur(22px) saturate(155%);
+  -webkit-backdrop-filter:blur(22px) saturate(155%); padding:12px;
+}
+#layersQuickPanel.open { display:block; animation:quickLayerIn .16s ease-out; }
+@keyframes quickLayerIn { from { opacity:0; transform:translateY(-5px) scale(.985); } to { opacity:1; transform:none; } }
+.quickTitle { display:flex; align-items:center; justify-content:space-between; gap:10px; margin:0 0 7px; }
+.quickTitle strong { font-size:15px; letter-spacing:-.01em; }
+.quickLayerRow { display:flex; align-items:center; justify-content:space-between; gap:12px; min-height:44px; padding:7px 4px; border-bottom:1px solid rgba(22,60,80,.07); }
+.quickLayerRow:last-of-type { border-bottom:0; }
+.quickLayerText { display:flex; flex-direction:column; gap:2px; font-size:13px; font-weight:750; }
+.quickLayerText small { color:var(--muted); font-size:10px; font-weight:600; }
+.toggleSwitch { position:relative; width:46px; height:27px; flex:0 0 auto; }
+.toggleSwitch input { position:absolute; opacity:0; pointer-events:none; }
+.toggleSwitch span { position:absolute; inset:0; border-radius:999px; background:#dbe6eb; box-shadow:inset 0 0 0 1px rgba(17,54,74,.08); transition:.18s ease; }
+.toggleSwitch span::after { content:''; position:absolute; width:21px; height:21px; border-radius:50%; left:3px; top:3px; background:white; box-shadow:0 2px 6px rgba(0,0,0,.18); transition:.18s ease; }
+.toggleSwitch input:checked + span { background:#1192c7; }
+.toggleSwitch input:checked + span::after { transform:translateX(19px); }
+.headingModeLabel { font-size:10px; color:var(--muted); text-transform:uppercase; letter-spacing:.08em; margin:10px 3px 6px; }
+.headingModeControl { display:grid; grid-template-columns:repeat(3,1fr); gap:5px; padding:4px; border-radius:16px; background:#edf4f7; }
+.headingModeControl button { border:0; min-height:36px; border-radius:12px; background:transparent; color:#36515f; font-size:11px; font-weight:800; }
+.headingModeControl button.active { background:white; color:#087bb1; box-shadow:0 2px 10px rgba(7,60,89,.12); }
+#windCanvas { position:absolute; inset:0; width:100%; height:100%; z-index:640; pointer-events:none; transform-origin:50% 50%; transition:transform .34s cubic-bezier(.22,.61,.36,1); }
+#windChip { right:12px; bottom:12px; display:none; max-width:220px; }
+#trackChip { top:58px; }
+#selectedLakeChip { top:102px; max-width:260px; }
+.windStatusDot { display:inline-block; width:7px; height:7px; border-radius:50%; background:#13a2cc; margin-right:5px; box-shadow:0 0 0 3px rgba(19,162,204,.14); }
+#quickWindStatus { margin-top:8px; padding:8px 9px; border-radius:14px; background:#edf7fb; font-size:10px; color:#47606d; line-height:1.35; }
+
 </style>
 <script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js" onerror="window.leafletFailed=true"></script>
 </head>
