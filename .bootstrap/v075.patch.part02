+      const regulations=regHtml ? parseDnrRegulationsHtml(regHtml,fish.species) : {rows:[],totalRows:0,general:[]};
+      selectedLake.fishingInfo={species:fish.species,clarity:fish.clarity,regulations};
+      selectedLake.fishingState=(fish.species.length||regulations.totalRows)?'ready':'unavailable';
+    } catch(e) {
+      if(requestId!==lakeDiscoveryFishingRequestId||!selectedLake) return;
+      selectedLake.fishingState='unavailable'; selectedLake.fishingInfo=null;
+    }
+    updateLakeDiscoveryUi(); renderLakeFishingInfo();
+  }
