+  async function refreshSelectedLakeFishingInfo(force=false) {
+    if(!selectedLake) return;
+    if(!selectedLake.wbic) { selectedLake.fishingState='unavailable'; selectedLake.fishingInfo=null; updateLakeDiscoveryUi(); renderLakeFishingInfo(); return; }
+    if(!force && selectedLake.fishingState==='ready') { renderLakeFishingInfo(); return; }
+    const requestId=++lakeDiscoveryFishingRequestId;
+    const key=String(selectedLake.wbic)+'|'+String(selectedLake.name||'');
+    selectedLake.fishingState='loading'; selectedLake.fishingInfo=null; updateLakeDiscoveryUi(); renderLakeFishingInfo();
+    const lakeUrl=lakeDnrDetailUrl(selectedLake), regUrl=lakeFishingRegulationsUrl(selectedLake);
+    const lakeReq=fetchDnrHtml(lakeUrl).then(parseDnrFishInfoHtml).catch(()=>({species:[],clarity:''}));
+    const regReq=fetchDnrHtml(regUrl).then(html=>html).catch(()=>null);
+    try {
+      const [fish,regHtml]=await Promise.all([lakeReq,regReq]);
