+  function createWaterEmphasisLayer() {
+    if (!window.L || !L.GridLayer) return null;
+    const HydroGrid=L.GridLayer.extend({
+      createTile: function(coords,done) {
+        const tile=document.createElement('img');
+        tile.alt='';
+        tile.setAttribute('role','presentation');
+        tile.style.width='256px'; tile.style.height='256px'; tile.style.pointerEvents='none';
+        tile.crossOrigin='anonymous';
+        try {
+          const size=this.getTileSize();
+          const nwPoint=coords.scaleBy(size);
+          const sePoint=nwPoint.add(size);
+          const nw=map.unproject(nwPoint,coords.z);
+          const se=map.unproject(sePoint,coords.z);
+          const pNW=L.CRS.EPSG3857.project(nw);
+          const pSE=L.CRS.EPSG3857.project(se);
+          const z=Number(coords.z)||0;
+          const lakeAlpha=z<=8?172:(z<=11?145:112);
+          const outlineAlpha=z<=8?245:220;
+          const outlineWidth=z<=8?2.2:(z<=11?1.8:1.35);
+          const riverWidth=z<=8?2.6:(z<=11?2.2:1.7);
+          const dynamic=[
+            {id:0,source:{type:'mapLayer',mapLayerId:0},minScale:0,maxScale:0,drawingInfo:{renderer:{type:'simple',symbol:{type:'esriSFS',style:'esriSFSSolid',color:[34,159,204,lakeAlpha],outline:{type:'esriSLS',style:'esriSLSSolid',color:[69,211,239,outlineAlpha],width:outlineWidth}}}}},
+            {id:1,source:{type:'mapLayer',mapLayerId:1},minScale:0,maxScale:0,drawingInfo:{renderer:{type:'simple',symbol:{type:'esriSLS',style:'esriSLSSolid',color:[48,190,229,238],width:riverWidth}}}}
+          ];
+          const params=new URLSearchParams({
+            bbox:[pNW.x,pSE.y,pSE.x,pNW.y].map(v=>Number(v).toFixed(2)).join(','),
+            bboxSR:'3857', imageSR:'3857', size:'512,512', dpi:'192', format:'png32', transparent:'true',
+            layers:'show:0,1', dynamicLayers:JSON.stringify(dynamic), f:'image'
+          });
+          tile.src='https://dnrmaps.wi.gov/arcgis/rest/services/ER_Biotics/ER_Biotics_WGS84_Hydro/MapServer/export?'+params.toString();
+          tile.onload=()=>done(null,tile);
+          tile.onerror=()=>done(null,tile);
+        } catch(e) { setTimeout(()=>done(null,tile),0); }
+        return tile;
+      }
+    });
+    return new HydroGrid({tileSize:256,minZoom:5,maxZoom:19,opacity:.86,keepBuffer:3,updateWhenIdle:false,updateWhenZooming:false,pane:'tilePane',className:'waterEmphasisTiles'});
