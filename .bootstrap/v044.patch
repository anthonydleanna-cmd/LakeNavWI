+  function routeCrossTrackInfo(loc,a,b) {
+    if (!loc || !a || !b) return null;
+    const R=6371000, rad=Math.PI/180;
+    const lat0=((Number(a.lat)+Number(b.lat)+Number(loc.lat))/3)*rad;
+    const cosLat=Math.max(.15,Math.cos(lat0));
+    const bx=(Number(b.lon)-Number(a.lon))*rad*R*cosLat;
+    const by=(Number(b.lat)-Number(a.lat))*rad*R;
+    const px=(Number(loc.lon)-Number(a.lon))*rad*R*cosLat;
+    const py=(Number(loc.lat)-Number(a.lat))*rad*R;
+    const len2=bx*bx+by*by;
+    if (!Number.isFinite(len2) || len2<1) return null;
+    const rawT=(px*bx+py*by)/len2;
+    const t=Math.max(0,Math.min(1,rawT));
+    const nx=bx*t, ny=by*t;
+    const dx=px-nx, dy=py-ny;
+    const meters=Math.hypot(dx,dy);
+    const cross=bx*py-by*px;
+    const side=cross>=0?'LEFT':'RIGHT';
+    const correction=side==='LEFT'?'RIGHT':'LEFT';
+    const nearest={
+      lat:Number(a.lat)+(Number(b.lat)-Number(a.lat))*t,
+      lon:Number(a.lon)+(Number(b.lon)-Number(a.lon))*t
+    };
+    return {meters,signedMeters:cross>=0?meters:-meters,side,correction,t,rawT,nearest,usable:rawT>=-.12&&rawT<=1.15};
+  }
+
+  function clearCrossTrackGuidance() {
+    offCourseActive=false;
+    if ($('navXte')) $('navXte').textContent='--';
+    if ($('navXteSide')) $('navXteSide').textContent='XTE';
+    if ($('xteChip')) $('xteChip').style.display='none';
+    if (map && xteGuideLine) { try { map.removeLayer(xteGuideLine); } catch(e) {} }
+    xteGuideLine=null;
+  }
+
+  function updateCrossTrackGuidance(route,pts) {
+    if (!currentLoc || !route || !pts || activeRouteIndex<=0 || activeRouteIndex>=pts.length) {
+      clearCrossTrackGuidance();
+      return null;
+    }
+    const a=pts[activeRouteIndex-1], b=pts[activeRouteIndex];
+    const info=routeCrossTrackInfo(currentLoc,a,b);
+    if (!info || !info.usable) { clearCrossTrackGuidance(); return info; }
+    const ft=info.meters*M_TO_FT;
+    if ($('navXte')) $('navXte').textContent=ft<1000?Math.round(ft)+' ft':(ft/5280).toFixed(2)+' mi';
+    if ($('navXteSide')) $('navXteSide').textContent='XTE '+info.side;
+
+    const limitM=xteLimitFt/M_TO_FT;
+    const accuracy=Number.isFinite(Number(currentLoc.accuracy))&&Number(currentLoc.accuracy)>0?Number(currentLoc.accuracy):8;
+    const eligible=accuracy<=Math.max(24,limitM*.60);
+    const nextOff=offCourseActive ? info.meters>limitM*.72 : info.meters>limitM;
+    const warning=eligible && nextOff;
+    if (warning && !offCourseActive) {
+      const now=Date.now();
+      if (now-lastOffCourseNoticeAt>15000) {
+        lastOffCourseNoticeAt=now;
+        if (navigator.vibrate) { try { navigator.vibrate([90,70,90]); } catch(e) {} }
+        if (window.Android && Android.toast) Android.toast('Off course '+Math.round(ft)+' ft '+info.side+'. Steer '+info.correction+' toward route.');
+      }
+    }
+    offCourseActive=warning;
+
+    const chip=$('xteChip'), chipText=$('xteChipText');
+    if (chip && chipText) {
+      chip.style.display='block';
+      chip.classList.toggle('offCourse',warning);
+      chipText.textContent=(warning?'OFF COURSE • ':'XTE • ')+Math.round(ft)+' ft '+info.side+' • steer '+info.correction;
+    }
+
+    if (map && info.meters>6) {
+      const linePts=[[currentLoc.lat,currentLoc.lon],[info.nearest.lat,info.nearest.lon]];
+      const color=warning?'#f29900':'#1aa6c8';
+      if (!xteGuideLine) xteGuideLine=L.polyline(linePts,{color,weight:3,opacity:.72,dashArray:'6 7',interactive:false}).addTo(map);
+      else { xteGuideLine.setLatLngs(linePts); xteGuideLine.setStyle({color}); }
+    } else if (map && xteGuideLine) {
+      try { map.removeLayer(xteGuideLine); } catch(e) {}
+      xteGuideLine=null;
+    }
+    return info;
+  }
