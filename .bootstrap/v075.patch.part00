--- a/app/src/main/assets/index.html
+++ b/app/src/main/assets/index.html
@@ -208,6 +208,27 @@
 .lakeDiscoveryLaunchActions { display:flex; gap:5px; }
 .lakeDiscoveryLaunchActions button { min-height:31px; padding:0 8px; border-radius:10px; font-size:8px; font-weight:900; }
 .lakeDiscoveryLaunchMarker { filter:drop-shadow(0 2px 3px rgba(0,0,0,.28)); }
+.lakeLaunchPopup { min-width:190px; max-width:245px; color:#173b4b; }
+.lakeLaunchPopup strong { display:block; font-size:12px; line-height:1.2; }
+.lakeLaunchPopupMeta { margin:4px 0 8px; color:#647b86; font-size:9px; line-height:1.35; }
+.lakeLaunchPopup .btn { width:100%; min-height:34px; }
+.lakeFishingCard { margin-top:12px; padding:12px; border-radius:17px; background:#f3f8fa; border:1px solid #dfebf0; }
+.lakeFishingHead { display:flex; align-items:flex-start; justify-content:space-between; gap:10px; }
+.lakeFishingHead h3 { margin:0; font-size:14px; letter-spacing:-.015em; }
+.lakeFishingHead .muted { margin-top:2px; font-size:9px; }
+.lakeFishChips { display:flex; flex-wrap:wrap; gap:6px; margin-top:9px; }
+.lakeFishChip { display:inline-flex; align-items:center; gap:4px; padding:5px 8px; border-radius:999px; background:#e4f3f7; border:1px solid rgba(23,112,143,.11); color:#18586f; font-size:9px; font-weight:850; }
+.lakeFishChip small { opacity:.67; font-size:7px; font-weight:850; text-transform:uppercase; }
+.lakeFishEmpty { margin-top:9px; color:#70858e; font-size:9px; line-height:1.4; }
+.lakeRegList { margin-top:10px; border-top:1px solid rgba(80,126,145,.13); }
+.lakeRegRow { padding:9px 0; border-bottom:1px solid rgba(80,126,145,.13); }
+.lakeRegFish { font-size:10px; font-weight:950; color:#173e50; }
+.lakeRegSeason { margin-top:2px; color:#0c789f; font-size:8px; font-weight:850; }
+.lakeRegText { margin-top:3px; color:#607781; font-size:9px; line-height:1.4; }
+.lakeFishingActions { display:grid; grid-template-columns:1fr 1fr; gap:7px; margin-top:10px; }
+.lakeFishingActions .btn { min-height:36px; }
+.lakeFishingDisclaimer { margin-top:8px; color:#788b93; font-size:8px; line-height:1.35; }
+
 
 
 .offlineBadge { display: inline-block; border-radius: 10px; padding: 2px 7px; background: #e8f4eb; color: #165c2c; font-size: 10px; font-weight: 700; margin-left: 5px; }
