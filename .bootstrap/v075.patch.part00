+html.darkMode body .lakeFishEmpty, html.darkMode body .lakeFishingDisclaimer { color:#9db2bb; }
+html.darkMode body .lakeRegList, html.darkMode body .lakeRegRow { border-color:rgba(150,196,214,.13); }
+html.darkMode body .lakeRegFish { color:#e5f5f8; }
