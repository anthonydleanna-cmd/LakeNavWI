+  function smoothDisplayHeading(rawDeg, source) {
+    if (rawDeg == null) return null;
+    const now = Date.now();
+    if (renderedHeading == null || !Number.isFinite(renderedHeading)) {
+      renderedHeading = normalizeDegrees(rawDeg);
+      lastRenderedHeadingAt = now;
+      return renderedHeading;
+    }
+    let delta = shortestSignedAngle(renderedHeading, rawDeg);
+    const deadband = source === 'GPS course' ? 1.0 : 2.2;
+    if (Math.abs(delta) < deadband) return renderedHeading;
+
+    // The phone compass can jump indoors or near metal. Limit how much one sample can move the visual arrow.
+    const maxStep = source === 'GPS course' ? 18 : 8;
+    delta = Math.max(-maxStep, Math.min(maxStep, delta));
+    const alpha = source === 'GPS course' ? 0.34 : 0.18;
+    renderedHeading = normalizeDegrees(renderedHeading + delta * alpha);
+    lastRenderedHeadingAt = now;
+    return renderedHeading;
+  }
