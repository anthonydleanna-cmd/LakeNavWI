 .lakeDiscoveryStat span { display:block; color:var(--muted); font-size:8px; font-weight:850; letter-spacing:.06em; text-transform:uppercase; }
 .lakeDiscoveryStat strong { display:block; margin-top:3px; color:#173b4b; font-size:14px; }
 .lakeDiscoveryDataRow { display:flex; flex-wrap:wrap; gap:6px; margin-top:10px; }
+.lakeDiscoveryLaunchCard { margin-top:12px; padding:12px; border-radius:17px; background:#f3f8fa; border:1px solid #dfebf0; }
+.lakeDiscoveryLaunchHead { display:flex; align-items:flex-start; justify-content:space-between; gap:10px; margin-bottom:7px; }
+.lakeDiscoveryLaunchHead h3 { margin:0; font-size:14px; letter-spacing:-.015em; }
+.lakeDiscoveryLaunchHead .muted { font-size:9px; }
+.lakeDiscoveryLaunchRow { display:grid; grid-template-columns:1fr auto; gap:9px; align-items:center; padding:9px 0; border-top:1px solid rgba(80,126,145,.13); }
+.lakeDiscoveryLaunchRow:first-child { border-top:0; padding-top:3px; }
+.lakeDiscoveryLaunchName { font-size:11px; font-weight:900; color:#183f50; line-height:1.18; }
+.lakeDiscoveryLaunchMeta { margin-top:2px; color:#6b8089; font-size:9px; line-height:1.35; }
+.lakeDiscoveryLaunchActions { display:flex; gap:5px; }
+.lakeDiscoveryLaunchActions button { min-height:31px; padding:0 8px; border-radius:10px; font-size:8px; font-weight:900; }
+.lakeDiscoveryLaunchMarker { filter:drop-shadow(0 2px 3px rgba(0,0,0,.28)); }
+
 
 .offlineBadge { display: inline-block; border-radius: 10px; padding: 2px 7px; background: #e8f4eb; color: #165c2c; font-size: 10px; font-weight: 700; margin-left: 5px; }
 
