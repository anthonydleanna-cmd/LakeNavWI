+  function saveLakeTrackMatches() {
+    const validIds=new Set((trackHistory||[]).map(h=>String(h&&h.id||'')).filter(Boolean));
+    const dedup=new Map();
+    (lakeTrackMatches||[]).forEach(r=>{ if(r&&validIds.has(String(r.trackId||''))) dedup.set(String(r.trackId),r); });
+    lakeTrackMatches=[...dedup.values()].sort((a,b)=>Number(a.trackEndTime||0)-Number(b.trackEndTime||0)).slice(-120);
+    localStorage.setItem(STORAGE_LAKE_TRACK_MATCHES,JSON.stringify(lakeTrackMatches));
+  }
+
+  function pointInLakeRing(lon,lat,ring) {
+    if(!Array.isArray(ring)||ring.length<3) return false;
+    let inside=false;
+    for(let i=0,j=ring.length-1;i<ring.length;j=i++) {
+      const xi=Number(ring[i]&&ring[i][0]), yi=Number(ring[i]&&ring[i][1]);
+      const xj=Number(ring[j]&&ring[j][0]), yj=Number(ring[j]&&ring[j][1]);
+      if(!Number.isFinite(xi)||!Number.isFinite(yi)||!Number.isFinite(xj)||!Number.isFinite(yj)) continue;
+      const crosses=((yi>lat)!==(yj>lat)) && (lon < (xj-xi)*(lat-yi)/((yj-yi)||1e-12)+xi);
+      if(crosses) inside=!inside;
+    }
+    return inside;
+  }
+
+  function pointInLakeFeature(lat,lon,feature) {
+    const g=feature&&feature.geometry; if(!g||!Array.isArray(g.coordinates)) return false;
+    const inPoly=poly=>{
+      if(!Array.isArray(poly)||!poly.length||!pointInLakeRing(lon,lat,poly[0])) return false;
+      for(let i=1;i<poly.length;i++) if(pointInLakeRing(lon,lat,poly[i])) return false;
+      return true;
+    };
+    if(g.type==='Polygon') return inPoly(g.coordinates);
+    if(g.type==='MultiPolygon') return g.coordinates.some(inPoly);
+    return false;
+  }
+
+  function trackProbePaths(points,maxPoints=34) {
+    const segments=splitTrackSegments(points||[]).filter(seg=>seg.length>=2);
+    if(!segments.length) return [];
+    const totalRaw=segments.reduce((s,x)=>s+x.length,0)||1;
+    return segments.map(seg=>{
+      const budget=Math.max(2,Math.round(maxPoints*(seg.length/totalRaw)));
+      if(seg.length<=budget) return seg.map(p=>[Number(p.lon),Number(p.lat)]);
+      const out=[]; const step=(seg.length-1)/(budget-1);
+      for(let i=0;i<budget;i++) { const p=seg[Math.min(seg.length-1,Math.round(i*step))]; out.push([Number(p.lon),Number(p.lat)]); }
+      return out;
+    }).filter(path=>path.length>=2);
+  }
+
+  async function queryTrackLakeCandidates(history) {
+    const paths=trackProbePaths(history&&history.points,34);
+    if(!paths.length) return [];
+    const geometry=JSON.stringify({paths});
+    const url=dnrLakeQueryBase()+'where='+encodeURIComponent('HYDROTYPE IN (706,707,710)')+
+      '&geometry='+encodeURIComponent(geometry)+'&geometryType=esriGeometryPolyline&inSR=4326&spatialRel=esriSpatialRelIntersects'+
+      '&outFields='+encodeURIComponent('OBJECTID,WATERBODY_NAME,WATERBODY_ROW_NAME,WATERBODY_WBIC,HYDROTYPE')+
+      '&returnGeometry=true&outSR=4326&geometryPrecision=6&maxAllowableOffset=0.00005&resultRecordCount=60&f=geojson';
+    const resp=await fetch(url);
+    if(!resp.ok) throw new Error('DNR track lake lookup HTTP '+resp.status);
+    const json=await resp.json();
+    return Array.isArray(json&&json.features)?json.features:[];
+  }
+
+  function trackLakeMatchesForHistory(history,features) {
